# Codebuff / Freebuff upstream Bearer token.
# Required. Use the token body only, without the "Bearer " prefix.
# Multiple accounts can be separated by commas.
FREEBUFF_TOKEN=

# Local OpenAI-compatible API access key.
# Required for /v1/* APIs in this managed build.
# For multiple keys with per-key model allowlists, use FREEBUFF_API_KEYS (JSON) instead.
FREEBUFF_API_KEY=

# Admin panel login key for /admin.
# Change this before public deployment.
FREEBUFF_ADMIN_KEY=sk-admin

# Freebuff upstream API root.
FREEBUFF_API_BASE_URL=https://www.codebuff.com

# Zeroclick ad provider upstream root.
ZEROCLICK_BASE_URL=https://zeroclick.dev

# Ad provider order. The service tries each provider before creating a session.
FREEBUFF_AD_PROVIDERS=gravity,carbon

# Upstream HTTP request timeout in seconds.
FREEBUFF_TIMEOUT=60

# Proxy: disabled by default (direct upstream requests, ignoring HTTP_PROXY/HTTPS_PROXY).
# To enable, set FREEBUFF_PROXY_ENABLED=true and fill the separated fields below.
FREEBUFF_PROXY_ENABLED=false
FREEBUFF_PROXY_TYPE=socks5
FREEBUFF_PROXY_HOST=
FREEBUFF_PROXY_PORT=1080
FREEBUFF_PROXY_USERNAME=
FREEBUFF_PROXY_PASSWORD=

# Debug logging.
FREEBUFF_DEBUG=false
FREEBUFF_LOG_LEVEL=INFO
FREEBUFF_LOG_BODY_CHARS=2000
FREEBUFF_LOG_COLOR=true

# Admin in-memory log retention.
FREEBUFF_ADMIN_LOG_LINES=1000

# Request-record retention (in-memory history shown on the admin panel).
FREEBUFF_MAX_REQUEST_RECORDS=5000

# Max chat request body size in bytes. Requests larger than this are rejected
# with 413 before reaching the upstream (protects the upstream from oversized
# contexts/attachments). Default 307200 (2 MB).
FREEBUFF_MAX_REQUEST_BODY_BYTES=2097152

# Max tools per request. Official desktop uses ~40; too many MCP tools
# (e.g. 237) is a foreign-client fingerprint. Extra tools are dropped.
FREEBUFF_MAX_TOOLS=50

# Max messages per request. Keep system + last N messages; older history
# is dropped to avoid huge requests (ZCode can send 300+ messages).
FREEBUFF_MAX_MESSAGES=0

# Log every SSE stream chunk (chat stream line/chunk). Default false because
# a long tool-calling turn can generate thousands of log lines.
FREEBUFF_LOG_STREAM_CHUNKS=false

# Empty stream timeout (seconds). If no content arrives within this time,
# the proxy returns a clear error instead of forwarding an empty success.
FREEBUFF_EMPTY_STREAM_TIMEOUT=120

# Account rotation mode. One of:
#   throughput   - all accounts fan out for both premium and unlimited (max throughput, highest risk)
#   balanced     - unlimited fans out; premium uses only one account at a time and rotates on normal quota exhaustion
#   conservative - unlimited also uses only the first account; premium rotates like balanced
# Premium is disabled until the next 15:00 Asia/Shanghai after a banned/blocked account in balanced/conservative.
FREEBUFF_ROTATION_MODE=balanced

# Multiple API keys as JSON: [{"name": "...", "key": "...", "models": [...]}]
FREEBUFF_API_KEYS=

# Optional override appended after the real Buffy system prompt (usually not needed).
FREEBUFF_SYSTEM_PROMPT_OVERRIDE=

# Service bind address and port.
FREEBUFF_HOST=0.0.0.0
FREEBUFF_PORT=8000

# Upstream session id (auto-generated if empty; usually not needed).
FREEBUFF_SESSION_ID=

# Simulated client device info.
FREEBUFF_CLIENT_ID=
FREEBUFF_TIMEZONE=Asia/Shanghai
FREEBUFF_LOCALE=zh-CN
FREEBUFF_OS=windows
s
